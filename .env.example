# MongoDB connection string (local dev or Atlas)
MONGODB_URI=

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Base URL of the app (used for building invite links, redirects, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Attachments storage (abstracted; fill in when a provider is chosen) ---
# Example if using S3-compatible storage:
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=

# --- Subscription/billing provider (abstracted) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
